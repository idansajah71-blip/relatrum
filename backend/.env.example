APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./relatrum.db

# REQUIRED in production. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-strong-secret-here
JWT_EXPIRE_DAYS=7

# AI provider: mock | gemini | groq
# - mock: deterministic local processing, no API key needed (default, recommended for development)
# - gemini/groq: require their API key below
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=100
LLM_MAX_CALLS_PER_ANALYSIS=5
AI_TIMEOUT_SECONDS=45
AI_RETRY_LIMIT=2

ENABLE_LOCAL_EMBEDDINGS=false
ENABLE_AI_ALIGNMENT=false

STORAGE_DIR=./storage

CORS_ORIGINS=http://localhost:3000,http://localhost:4000
